{
  "name": "@tyloinfer/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:studio": "vite --config web/vite.config.ts",
    "build:studio": "tsc -b web && vite build --config web/vite.config.ts",
    "preview:studio": "vite preview --config web/vite.config.ts",
    "check:studio": "tsc -b web && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:studio": "vitest run --config web/vitest.config.ts",
    "test:e2e:studio": "playwright test --config web/playwright.config.ts",
    "tauri:studio": "tauri",
    "package:studio": "uv run --no-project ../packaging/build_release.py",
    "package:agent": "tauri build --config src-tauri/tauri.agent.conf.json",
    "build:plugins": "tsc -p plugins/tsconfig.host.json && node plugins/build.mts",
    "build:dsbot": "tsc -p plugins/tsconfig.host.json && node plugins/build.mts --dsbot",
    "typecheck:plugins": "tsc -p plugins/tsconfig.host.json --noEmit && tsc -p plugins/tsconfig.client.json",
    "test:plugins": "pnpm build:plugins && node --test plugins/src/host/tests/*.test.ts plugins/src/client/tests/*.test.ts",
    "build": "pnpm build:studio && pnpm build:plugins",
    "typecheck": "tsc -b web --pretty false && tsc -p web/tsconfig.test.json --pretty false && tsc -p plugins/tsconfig.host.json --noEmit && tsc -p plugins/tsconfig.client.json",
    "test": "pnpm test:studio && pnpm test:plugins"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "2.11.1",
    "dompurify": "^3.4.16",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^5.0.1"
  }
}
